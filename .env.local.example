# Kopyala: .env.local (git'e gitmez)

# Supabase (Akiyom projesi — lisans tablosu)
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...

# E-posta dogrulama / sifre sifirlama linkinin acacagi sayfa (marina web site)
# Supabase Dashboard > Authentication > URL Configuration:
#   Site URL = bu adres
#   Redirect URLs listesine de ekleyin
# Gelistirme: http://localhost:5174/uyelik-onay
# Canli: https://siteniz.com/uyelik-onay
MARINA_AUTH_REDIRECT_URL=http://localhost:5174/uyelik-onay

# --- GELISTIRME: kendi lisans kodun (musteriden ayri) ---
# Supabase pos_licenses satirinda app_code bu olmali.
# Musteri kurulumunda bu satir YOK; paket varsayilan marina-pos kullanir.
# Supabase'deki app_code ile AYNI (ornek: Erdin_Test)
# MARINA_LICENSE_APP_CODE=Erdin_Test

# Gelistirmede varsayilan: cihaz baglanmaz (musteri anahtarini bozmazsin).
# Gercek tek-PC testi icin: MARINA_LICENSE_BIND_DEVICE=1

# Lisansi tamamen atla (sadece yerel test):
# MARINA_SKIP_LICENSE=1

# Asistan model indirme (Hugging Face — istege bagli, cogunlukla gerekmez):
# HF_TOKEN=hf_...

# ASLA repoya veya musteri .exe yanina koymayin:
# SUPABASE_SERVICE_ROLE_KEY=
