{
  "name": "marina-nargile-pos",
  "version": "1.8.8",
  "private": true,
  "description": "Marina Nargile POS otomasyon",
  "author": "Marina",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "electron:mark-cjs": "node scripts/ensure-dist-electron-cjs.mjs",
    "dev": "concurrently \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 file:dist-electron/electron/main.js && npm run electron:mark-cjs && electron .\"",
    "copy:wasm": "node scripts/copy-transformers-wasm.mjs",
    "build": "tsc -b && vite build && tsc -p tsconfig.electron.json && npm run electron:mark-cjs",
    "postinstall": "node scripts/copy-transformers-wasm.mjs",
    "pack": "npm run build && electron-builder --win --config.npmRebuild=false",
    "pack:release": "node scripts/verify-release-ready.mjs && node scripts/write-supabase-license-from-env.mjs && npm run release:notes && npm run build && electron-builder --win --config.npmRebuild=false",
    "release:verify": "node scripts/verify-release-ready.mjs",
    "release:notes": "node scripts/extract-release-notes.mjs",
    "publish:win": "npm run release:notes && npm run build && electron-builder --win --publish always --config.npmRebuild=false",
    "pack:dir": "npm run build && electron-builder --win dir --config.npmRebuild=false",
    "preview": "vite preview",
    "lint": "eslint .",
    "start": "npm run electron:mark-cjs && electron ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.0",
    "@xenova/transformers": "^2.17.2",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.38.0",
    "jsbarcode": "^3.12.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^35.1.4",
    "electron-builder": "^26.8.1",
    "eslint": "^9.24.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "png-to-ico": "^3.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1",
    "vite": "^6.3.2",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.marina.nargile.pos",
    "productName": "Marina Nargile POS",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/transformers-wasm{,/**}",
      "dist-electron/**/*",
      "build/icons/**/*",
      "build/license-registry.url",
      "build/supabase-license.json",
      "package.json",
      "!**/node_modules/sharp{,/**}",
      "!**/node_modules/onnxruntime-node/bin/napi-v3/darwin{,/**}",
      "!**/node_modules/onnxruntime-node/bin/napi-v3/linux{,/**}",
      "!**/node_modules/onnxruntime-node/bin/napi-v3/win32/arm64{,/**}",
      "!**/node_modules/@xenova/transformers/dist/ort-wasm.wasm",
      "!**/node_modules/@xenova/transformers/dist/ort-wasm-threaded.wasm",
      "!**/node_modules/@xenova/transformers/dist/ort-wasm-simd-threaded.wasm"
    ],
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/napi-v3/win32/x64/**"
    ],
    "afterPack": "scripts/prune-win-unpacked.mjs",
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Marina-Nargile-POS-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "erdinoral",
      "repo": "marinapos",
      "releaseType": "release",
      "vPrefixedTagName": false
    },
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    }
  }
}
