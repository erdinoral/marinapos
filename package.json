{
  "name": "marina-nargile-pos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "electron:mark-cjs": "node scripts/ensure-dist-electron-cjs.mjs",
    "dev": "concurrently \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 file:dist-electron/electron/main.js && npm run electron:mark-cjs && electron .\"",
    "build": "tsc -b && vite build && tsc -p tsconfig.electron.json && npm run electron:mark-cjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "start": "npm run electron:mark-cjs && electron ."
  },
  "dependencies": {
    "electron": "^35.1.4",
    "framer-motion": "^12.38.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.24.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1",
    "vite": "^6.3.2",
    "wait-on": "^8.0.3"
  }
}
